APP_NAME=Web Autopsy Network API
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://web_autopsy:change-me-for-local-development@localhost:5432/web_autopsy
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
JWT_SECRET=replace-with-a-long-local-only-secret

# Phase 3 crawler defaults and server-enforced hard ceilings
CRAWL_DEFAULT_MAX_DEPTH=2
CRAWL_MAX_DEPTH_CAP=5
CRAWL_DEFAULT_MAX_PAGES=30
CRAWL_MAX_PAGES_CAP=100
CRAWL_DEFAULT_CONCURRENCY=2
CRAWL_MAX_CONCURRENCY_CAP=4
CRAWL_DEFAULT_DELAY_MS=1000
CRAWL_MIN_DELAY_MS=100
CRAWL_SAME_DOMAIN_MODE=hostname

# Extension 1 assessment policy. Generate a Fernet key for production and keep it out of source control.
ASSESSMENT_POLICY_VERSION=assessment-v1
ASSESSMENT_ENCRYPTION_KEY=
ASSESSMENT_ALLOW_PRIVATE_TARGETS=false
ASSESSMENT_PRIVATE_TARGET_ALLOWLIST=
ASSESSMENT_ROBOTS_OVERRIDE_PROFILES=aggressive
ASSESSMENT_SAFE_MAX_DEPTH=2
ASSESSMENT_SAFE_MAX_REQUESTS=30
ASSESSMENT_SAFE_MAX_CONCURRENCY=2
ASSESSMENT_SAFE_MIN_RATE_LIMIT_MS=1000
ASSESSMENT_NORMAL_MAX_DEPTH=3
ASSESSMENT_NORMAL_MAX_REQUESTS=50
ASSESSMENT_NORMAL_MAX_CONCURRENCY=3
ASSESSMENT_NORMAL_MIN_RATE_LIMIT_MS=500
ASSESSMENT_AGGRESSIVE_MAX_DEPTH=5
ASSESSMENT_AGGRESSIVE_MAX_REQUESTS=100
ASSESSMENT_AGGRESSIVE_MAX_CONCURRENCY=4
ASSESSMENT_AGGRESSIVE_MIN_RATE_LIMIT_MS=250

# LLM configuration (Phase 10)
LLM_API_KEY=your-llm-api-key-here
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Extension 2 Recon Agent: bounded passive public-source and active-safe discovery
RECON_PASSIVE_TIMEOUT_SECONDS=8
RECON_CT_MAX_RECORDS=200
RECON_DNS_RECORD_TYPES=A,AAAA,CNAME,MX,NS,TXT
RECON_ACTIVE_SAFE_MAX_CANDIDATES=24
RECON_ACTIVE_SAFE_MAX_SITEMAP_URLS=10
RECON_ACTIVE_SAFE_MAX_BODY_BYTES=1048576
RECON_ACTIVE_SAFE_PATH_WORDLIST=/.well-known/security.txt,/sitemap.xml,/sitemap_index.xml,/manifest.json,/openapi.json,/swagger.json,/api,/graphql,/login,/admin,/health,/status,/docs

# Extension 3 HTTP Agent: stored-response analysis limits (no additional target requests)
HTTP_AGENT_MAX_VALUE_BYTES=8192
HTTP_AGENT_MAX_TEXT_BYTES=512
HTTP_AGENT_MAX_BODY_BYTES=5242880
