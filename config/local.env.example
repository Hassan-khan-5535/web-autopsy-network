COMPOSE_PROJECT_NAME=web-autopsy-network
POSTGRES_DB=web_autopsy
POSTGRES_USER=web_autopsy
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://web_autopsy:change-me-for-local-development@postgres:5432/web_autopsy
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
APP_ENV=development
JWT_SECRET=replace-with-a-long-local-only-secret

# Phase 3 crawler defaults and server-enforced hard ceilings
CRAWL_DEFAULT_MAX_DEPTH=2
CRAWL_MAX_DEPTH_CAP=5
CRAWL_DEFAULT_MAX_PAGES=30
CRAWL_MAX_PAGES_CAP=100
CRAWL_DEFAULT_CONCURRENCY=2
CRAWL_MAX_CONCURRENCY_CAP=4
CRAWL_DEFAULT_DELAY_MS=1000
CRAWL_MIN_DELAY_MS=100
CRAWL_SAME_DOMAIN_MODE=hostname
